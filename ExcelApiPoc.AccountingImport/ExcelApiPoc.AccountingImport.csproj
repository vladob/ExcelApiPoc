<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfLayoutEngine\PdfLayoutEngine.csproj" />
    <ProjectReference Include="..\PdfLayoutEngine.Xps\PdfLayoutEngine.Xps.csproj" />
    <ProjectReference Include="..\PdfLayoutEngine.IText\PdfLayoutEngine.IText.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Retained for direct legacy-parser regression tests, not AddIn dispatch. -->
    <EmbeddedResource Include="../PdfLayouts/IfoSoft/journal-dennik1.v1.json">
      <LogicalName>ExcelApiPoc.AccountingImport.PdfLayouts.IfoSoft.journal-dennik1.v1.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\PdfLayouts\SoftipMop\general-ledger.v1.json">
      <Link>PdfLayouts\SoftipMop\general-ledger.v1.json</Link>
      <LogicalName>ExcelApiPoc.AccountingImport.PdfLayouts.SoftipMop.general-ledger.v1.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\PdfLayouts\Ives\journal.v1.json">
      <Link>PdfLayouts\Ives\journal.v1.json</Link>
      <LogicalName>ExcelApiPoc.AccountingImport.PdfLayouts.Ives.journal.v1.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\PdfLayouts\Ives\general-ledger.v1.json">
      <Link>PdfLayouts\Ives\general-ledger.v1.json</Link>
      <LogicalName>ExcelApiPoc.AccountingImport.PdfLayouts.Ives.general-ledger.v1.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\PdfLayouts\Ives\accounting-framework.v1.json">
      <Link>PdfLayouts\Ives\accounting-framework.v1.json</Link>
      <LogicalName>ExcelApiPoc.AccountingImport.PdfLayouts.Ives.accounting-framework.v1.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../PdfLayouts/IfoSoft/Compact/*.json">
      <LogicalName>StagedLayouts/IfoSoft/Compact/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../PdfLayouts/Ives/Compact/*.json">
      <LogicalName>StagedLayouts/Ives/Compact/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../PdfLayouts/Omega/Compact/*.json">
      <LogicalName>StagedLayouts/Omega/Compact/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../PdfLayouts/SoftipMop/Compact/*.json">
      <LogicalName>StagedLayouts/SoftipMop/Compact/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../PdfLayouts/Urbis/Compact/*.json">
      <LogicalName>StagedLayouts/Urbis/Compact/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>

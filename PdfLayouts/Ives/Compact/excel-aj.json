  "report": {
    "identifiers": [
      {
        "row": 2,
        "column": 1,
        "pattern": "^(?<AccountingEntityName>.+)$"
      },
      {
        "row": 3,
        "column": 22,
        "pattern": "^IČO:\\s*(?<cin>\\d{8})$"
      },
      {
        "row": 8,
        "column": 1,
        "pattern": "^Dátum vytvorenia\\s+od:\\s*(?<PeriodFrom>\\d{1,2}\\.\\d{1,2}\\.\\d{4}),\\s*do:\\s*(?<PeriodTo>\\d{1,2}\\.\\d{1,2}\\.\\d{4})$"
      }

      "DebitAccount",
      "CreditAccount"
    ],
    "totalFields": [
      "Amount"
    ],
    "requiredFields": [
      "DocumentNumber"
    ],
    "rules": [
      {
        "kind": "Record",
        "match": {
          "1": "^(?!Spolu).+",
          "4": "^\\S+$"
        },
        "allowedColumns": [
          1,
          4,
          8,
          17,
          23,
          25,
          27
        ]
      },
      {
        "kind": "Continuation",
        "match": {
          "1": "^$",
          "4": "^$",
          "23": "^$",
          "27": "^\\S+$"
        },
        "allowedColumns": [
          8,
          13,
          17,
          19,
          27,
          28,
          29
        ]
      },
      {
        "kind": "ReportTotal",
        "match": {
          "1": "^Spolu\\s*:"
        },
        "allowedColumns": [
          1,
          23,
          25
        ]
      },
      {
        "kind": "Group",
        "match": {
          "1": "^(Hlavná|Podnikateľská) činnosť$",
          "4": "^$"
        },
        "allowedColumns": [
          1,
          9
        ],
        "columns": {
          "GroupName": 1
        }
      }
    ]
  }

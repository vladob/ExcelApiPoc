{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.excelapipoc.local/positioned/v2/result.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "format": {
      "enum": [
        "PDF",
        "XPS",
        "OXPS",
        "unknown"
      ]
    },
    "processingStatus": {
      "enum": [
        "success",
        "incomplete",
        "failed",
        "unsupported",
        "excluded"
      ]
    },
    "requestedLevels": {
      "type": "object",
      "properties": {
        "extraction": {
          "enum": [
            "recognition",
            "metadata",
            "records"
          ]
        },
        "validation": {
          "enum": [
            "none",
            "completeness",
            "internalConsistency"
          ]
        }
      },
      "required": [
        "extraction",
        "validation"
      ],
      "additionalProperties": false
    },
    "effectiveLevels": {
      "type": "object",
      "properties": {
        "extraction": {
          "enum": [
            "recognition",
            "metadata",
            "records"
          ]
        },
        "validation": {
          "enum": [
            "none",
            "completeness",
            "internalConsistency"
          ]
        }
      },
      "required": [
        "extraction",
        "validation"
      ],
      "additionalProperties": false
    },
    "recognitionDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "enum": [
              "category",
              "producer",
              "layout"
            ]
          },
          "state": {
            "enum": [
              "confirmed",
              "tentative",
              "ambiguous",
              "unknown"
            ]
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "score": {
                  "type": "number"
                },
                "evidenceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0
                }
              },
              "required": [
                "id",
                "score",
                "evidenceRefs"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "target",
          "state",
          "candidates"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/value"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/record"
      },
      "minItems": 0
    },
    "printedControls": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/value"
      }
    },
    "calculations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ruleId": {
            "type": "string",
            "minLength": 1
          },
          "scopeOccurrenceId": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "pass",
              "fail",
              "inconclusive",
              "notEvaluated"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "inputRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "ruleId",
          "scopeOccurrenceId",
          "state",
          "value",
          "inputRefs"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "validationResults": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ruleId": {
            "type": "string",
            "minLength": 1
          },
          "scopeOccurrenceId": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "pass",
              "fail",
              "inconclusive",
              "notEvaluated"
            ]
          },
          "calculatedValue": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "printedValue": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "difference": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "ruleId",
          "scopeOccurrenceId",
          "state",
          "calculatedValue",
          "printedValue",
          "difference",
          "reason",
          "evidenceRefs"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "coverage": {
      "$ref": "common.schema.json#/$defs/coverage"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/diagnostic"
      },
      "minItems": 0
    },
    "provenance": {
      "type": "object",
      "properties": {
        "documentHash": {
          "type": "string",
          "minLength": 1
        },
        "engineVersion": {
          "type": "string",
          "minLength": 1
        },
        "definitions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "version",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/evidence"
          },
          "minItems": 0
        },
        "transforms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "sourceToNormalized": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 6,
                "maxItems": 6
              },
              "normalizedToSource": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 6,
                "maxItems": 6
              }
            },
            "required": [
              "id",
              "sourceToNormalized",
              "normalizedToSource"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "documentHash",
        "engineVersion",
        "definitions",
        "evidence",
        "transforms"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "format",
    "processingStatus",
    "requestedLevels",
    "effectiveLevels",
    "recognitionDecisions",
    "metadata",
    "records",
    "printedControls",
    "calculations",
    "validationResults",
    "coverage",
    "diagnostics",
    "provenance"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.excelapipoc.local/positioned/v2/parsers.schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 2
    },
    "definitionVersion": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "parsers"
    },
    "status": {
      "enum": [
        "reviewDraft",
        "approved"
      ]
    },
    "productionApproved": {
      "type": "boolean"
    },
    "requiresCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/source"
      },
      "minItems": 0
    },
    "reviewNotes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/parser"
      },
      "minItems": 1
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "definitionVersion",
    "id",
    "kind",
    "status",
    "productionApproved",
    "requiresCapabilities",
    "sourceRefs",
    "reviewNotes",
    "profiles"
  ],
  "additionalProperties": false
}

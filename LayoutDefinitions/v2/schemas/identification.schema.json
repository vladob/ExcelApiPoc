{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.excelapipoc.local/positioned/v2/identification.schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 2
    },
    "definitionVersion": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "identification"
    },
    "status": {
      "enum": [
        "reviewDraft",
        "approved"
      ]
    },
    "productionApproved": {
      "type": "boolean"
    },
    "requiresCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/source"
      },
      "minItems": 0
    },
    "reviewNotes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "scan": {
      "type": "object",
      "properties": {
        "initialPages": {
          "$ref": "common.schema.json#/$defs/pageScope"
        },
        "additionalPages": {
          "$ref": "common.schema.json#/$defs/pageScope"
        },
        "expandWhen": {
          "const": "unresolvedDecision"
        },
        "onBudgetExhausted": {
          "const": "retainCoverageAndUnresolvedDecisions"
        }
      },
      "required": [
        "initialPages",
        "additionalPages",
        "expandWhen",
        "onBudgetExhausted"
      ],
      "additionalProperties": false
    },
    "signals": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/signal"
      },
      "minItems": 1
    },
    "evidenceGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scoreCap": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "repeatedOccurrences": {
            "const": "maximumOnce"
          }
        },
        "required": [
          "id",
          "scoreCap",
          "repeatedOccurrences"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/decision"
      },
      "minItems": 1
    },
    "layoutCandidates": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/reference"
      },
      "minItems": 1
    },
    "onTie": {
      "const": "retainCandidates"
    },
    "scoreMeaning": {
      "const": "rankingNotProbability"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "definitionVersion",
    "id",
    "kind",
    "status",
    "productionApproved",
    "requiresCapabilities",
    "sourceRefs",
    "reviewNotes",
    "scan",
    "signals",
    "evidenceGroups",
    "decisions",
    "layoutCandidates",
    "onTie",
    "scoreMeaning"
  ],
  "additionalProperties": false
}
